executors:
  k8s-default-tools:
    botkube/kubectl:
      enabled: true
      displayName: Kubectl
      config:
        defaultNamespace: demo

communications:
  default-group:
    socketSlack:
      enabled: true
      botToken: xoxb-11430725530179-11430837773251-yFgYNeYYfh7U2zirsD9OCcCD
      appToken: xapp-1-A0BCX05M7G9-11450722178581-daac96a03853e9cef0dc3c40928324b6e55630acfe7e2676ef93e57ef90acc04

      channels:
        default:
          name: devops
          bindings:
            executors:
              - k8s-default-tools
            sources:
              - k8s-all-events
              - k8s-err-events
              - k8s-recommendation-events

settings:
  clusterName: dev-kalpesh-demo
