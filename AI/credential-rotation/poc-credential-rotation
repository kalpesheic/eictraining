import boto3
import pymysql
import json
import logging
import secrets
import string

logger = logging.getLogger()
logger.setLevel(logging.INFO)

secrets_client = boto3.client("secretsmanager")


def generate_password(length=20):
    characters = string.ascii_letters + string.digits + "!@#$%^&*"

    return ''.join(
        secrets.choice(characters)
        for _ in range(length)
    )


def lambda_handler(event, context):

    secret_name = "test-db"

    logger.info("Starting password rotation")

    # --------------------------------------------------
    # 1. Get existing credentials from Secrets Manager
    # --------------------------------------------------

    logger.info("Reading existing secret")

    response = secrets_client.get_secret_value(
        SecretId=secret_name
    )

    secret = json.loads(response["SecretString"])

    username = secret["username"]
    old_password = secret["password"]
    host = secret["host"]
    port = int(secret.get("port", 3306))
    database = secret.get("database", "")

    logger.info("Existing secret retrieved")
    logger.info("Username: %s", username)
    logger.info("RDS Host: %s", host)

    # --------------------------------------------------
    # 2. Generate new password
    # --------------------------------------------------

    new_password = generate_password()

    logger.info("New password generated")

    # --------------------------------------------------
    # 3. Connect to RDS using OLD password
    # --------------------------------------------------

    logger.info("Connecting to RDS using existing credentials")

    connection = pymysql.connect(
        host=host,
        user=username,
        password=old_password,
        port=port,
        database=database,
        connect_timeout=10,
        read_timeout=10,
        write_timeout=10,
        autocommit=True
    )

    logger.info("RDS connection successful")

    try:

        # --------------------------------------------------
        # 4. Change password
        # --------------------------------------------------

        with connection.cursor() as cursor:

            sql = f"ALTER USER `{username}` IDENTIFIED BY %s"

            cursor.execute(
                sql,
                (new_password,)
            )

        logger.info("RDS password changed successfully")

    finally:

        connection.close()

    # --------------------------------------------------
    # 5. Update Secrets Manager
    # --------------------------------------------------

    logger.info("Updating Secrets Manager")

    secret["password"] = new_password

    secrets_client.put_secret_value(
        SecretId=secret_name,
        SecretString=json.dumps(secret)
    )

    logger.info("Secrets Manager updated successfully")

    # --------------------------------------------------
    # 6. Verify NEW password
    # --------------------------------------------------

    logger.info("Testing new password")

    test_connection = pymysql.connect(
        host=host,
        user=username,
        password=new_password,
        port=port,
        database=database,
        connect_timeout=10,
        read_timeout=10,
        write_timeout=10
    )

    try:

        with test_connection.cursor() as cursor:

            cursor.execute("SELECT 1")

            result = cursor.fetchone()

        logger.info("New password verification successful")

    finally:

        test_connection.close()

    # --------------------------------------------------
    # 7. Return result
    # --------------------------------------------------

    return {
        "statusCode": 200,
        "body": json.dumps({
            "message": "Password changed successfully",
            "rds_password_change": "SUCCESS",
            "secrets_manager_update": "SUCCESS",
            "new_password_verification": "SUCCESS",
            "query_result": result[0]
        })
    }